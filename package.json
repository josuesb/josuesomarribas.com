{
  "name": "josue-somarribas-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node scripts/clean-build-output.mjs",
    "dev": "vinext dev",
    "build": "vinext build && node scripts/generate-static-metadata.mjs",
    "build:sanity": "node scripts/sync-sanity-content.mjs && SANITY_CONTENT_SOURCE=remote npm run build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audio:generate": ".venv-tts/bin/python scripts/tts/generate_audio.py",
    "audio:optimize": "node scripts/optimize-blog-audio.mjs",
    "images:migrate-framer": "node scripts/migrate-framer-images.mjs",
    "content:migrate": "node scripts/migrate-framer-content.mjs",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build dist/studio",
    "sanity:deploy": "sanity deploy",
    "sanity:prepare-import": "node scripts/export-sanity-import.mjs",
    "sanity:sync": "node scripts/sync-sanity-content.mjs",
    "sanity:migrate-portable-text": "sanity exec scripts/migrate-sanity-portable-text.mjs --with-user-token",
    "sanity:migrate-media": "sanity exec scripts/migrate-sanity-media.mjs --with-user-token",
    "sanity:translate-selected": "sanity exec scripts/translate-sanity-articles.mjs --with-user-token",
    "sanity:classify-drafts": "sanity exec scripts/classify-sanity-drafts.mjs --with-user-token",
    "sanity:import": "npm run sanity:prepare-import && sanity dataset import work/sanity-import.ndjson --dataset production --replace",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@portabletext/block-tools": "^6.0.0",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.4.0",
    "@sanity/code-input": "^7.3.8",
    "@sanity/vision": "^6.12.0",
    "drizzle-orm": "0.45.2",
    "jsdom": "^26.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanity": "^6.12.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
